__pycache__/
*.py[cod]
*.egg-info/
build/
.env
venv/
.venv/
*.log

# Cache & generated outputs
cache/
output/
crash.log

# Frontend build (regenerated via npm run build)
frontend/dist/
frontend/node_modules/

# Rust / Tauri build output
frontend/src-tauri/target/

# Large ML model files — tracked by path to keep the models/ dir
*.pt
*.bin
*.gguf
*.safetensors
*.h5
*.msgpack
*.ckpt
models/**/*.onnx
models/**/*.weights
# root-level stragglers
/*.pt
/*.bin
/*.gguf

# Partial HuggingFace downloads. A 112 MB *.incomplete blob was tracked and
# would have entered history permanently — it is never a valid model.
*.incomplete
.download_owner_lock
**/.locks/

# Throwaway experiment + debug artefacts at the repo root. The _ab_* set is the
# closed 2026-06 VLM tournament; nothing outside that set imports them.
/_ab_*
/_cull_*.out
/_dl_*.out
/_tmp_*.py
/_train_baseline.py
/srv_out*.txt
/srv_err*.txt

# Legacy backup files
*.legacy_backup

# Claude Code session memory (local only)
.claude/

# OS
.DS_Store
Thumbs.db

# Isolated Edge profile
StreetStoryCurator/

# Machine state, not source. models/.models_ready was TRACKED, so a fresh clone
# arrived claiming models were installed while carrying none — the first-run
# prefetch then short-circuited and nothing ever downloaded.
models/.models_ready
models/**/refs/
models/dpo_adapter/*.db

# Parity backups kept beside a refactor (e.g. server_impl.pre_split.bak).
# Deliberately kept on disk as a reference; never a tracked artifact.
*.bak

# Rust build output. 588 files, 395 MB, including two .rlib/.rmeta over 88 MB
# that GitHub warns about on every push. Nobody can use a compiled artifact
# from someone else's machine, and every "Download ZIP" was dragging it along.
native/framegrade-rs/target/

# PyInstaller output
dist/
build_pyi/
pyi_build*.log
